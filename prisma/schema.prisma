// White Oak Payroll data model. Money is stored as integer cents.
// Standard Postgres only (no host-specific extensions) so the database can move hosts.

generator client {
  provider      = "prisma-client-js"
  // native for Vercel/dev, musl for the Alpine Docker image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN // White Oak staff: every company
  CLIENT_OWNER // the business owner: payroll, bank, taxes, billing
  CLIENT_HR // limited: onboard and offboard employees and contractors only
  EMPLOYEE // employee portal: own paystubs, W-2s, advances
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

/**
 * How a company is run. SELF_SERVE: the owner runs payroll and employees use the portal.
 * MANAGED: White Oak staff (the payroll desk) enter everything; the client sees reports and adds people.
 */
enum ServiceMode {
  SELF_SERVE
  MANAGED
}

enum PayBasis {
  HOURLY
  SALARIED
}

enum WorkerStatus {
  ONBOARDING
  ACTIVE
  TERMINATED
}

enum PayRunStatus {
  DRAFT
  APPROVED
  PAID
  VOIDED
}

enum AddOn {
  TIME_TRACKING
  PTO
}

enum AdvanceStatus {
  REQUESTED
  ACTIVE
  REPAID
  DECLINED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  /** scrypt hash: salt:hash, hex. Empty while an emailed invite is waiting to be accepted. */
  passwordHash String
  /** SHA-256 of the emailed invite link's token; cleared once they set a password. */
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime?
  /** SHA-256 of an emailed "forgot password" link's token; single use, short-lived. */
  resetTokenHash  String?   @unique
  resetExpiresAt  DateTime?
  /** Only White Oak staff. Client roles live on Membership. */
  isPlatformAdmin Boolean   @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  employee     Employee?
}

model Session {
  id        String   @id @default(cuid())
  /** SHA-256 of the cookie token; the token itself is never stored. */
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Company {
  id            String          @id @default(cuid())
  legalName     String
  tradeName     String?
  ein           String
  addressLine1  String
  city          String
  state         String
  zip           String
  /** Bank account the payroll is funded from (stub until TD Bank is integrated). Last 4 only. */
  bankName      String?
  bankLast4     String?
  /** 941 depositor schedule: MONTHLY or SEMIWEEKLY. */
  depositSchedule String        @default("MONTHLY")
  /** Next paper check number to print. */
  nextCheckNumber Int           @default(1001)
  serviceMode   ServiceMode     @default(SELF_SERVE)
  /** Per-company feature switches over the mode's defaults (src/lib/app/features.ts). */
  features      Json            @default("{}")
  /** When the owner finished the setup wizard. */
  setupCompletedAt DateTime?
  createdAt     DateTime        @default(now())
  reminders     Reminder[]
  stateAccounts StateAccount[]
  memberships   Membership[]
  paySchedules  PaySchedule[]
  employees     Employee[]
  contractors   Contractor[]
  payRuns       PayRun[]
  modules       CompanyModule[]
  timeSettings  TimeSettings?
  workLocations WorkLocation[]
  timeEntries   TimeEntry[]
  filings       Filing[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
  checks        Check[]
  retirementPlans RetirementPlan[]
}

model StateAccount {
  id                  String  @id @default(cuid())
  companyId           String
  company             Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  state               String // CT, MA, OR, NY
  withholdingAccount  String?
  unemploymentAccount String?
  /** Assigned unemployment rate, e.g. 0.03. */
  suiRate             Float
  suiWageBaseCents    Int
  /** CT: Labor Commissioner approval for pay less often than bi-weekly. */
  lessFrequentPayApproval Boolean @default(false)
  /** OR only: work site in the TriMet or Lane Transit District (trimet | lane). */
  orTransitDistrict   String?

  @@unique([companyId, state])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model CompanyModule {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  addOn     AddOn
  enabledAt DateTime @default(now())

  @@unique([companyId, addOn])
}

model PaySchedule {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  frequency    PayFrequency
  /** A payday on this schedule; later paydays step forward from it. */
  anchorPayday DateTime
  /** Days between period end and payday. */
  payLagDays   Int          @default(5)
  employees    Employee[]
  payRuns      PayRun[]
}

model Employee {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payScheduleId    String
  paySchedule      PaySchedule  @relation(fields: [payScheduleId], references: [id])
  /** Portal login, created when the employee is invited. */
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id])
  timeEntries      TimeEntry[]
  firstName        String
  lastName         String
  email            String
  /** Preview mode only accepts test SSNs (000-xx-xxxx). Encrypt before real data. */
  ssn              String
  /** Empty until a self-onboarding employee enters it. */
  birthDate        DateTime?
  hireDate         DateTime
  terminationDate  DateTime?
  terminationReason String?
  status           WorkerStatus @default(ONBOARDING)
  addressLine1     String
  city             String
  state            String
  zip              String
  workState        String
  /** NY only: NYC or YONKERS resident for local withholding. */
  localJurisdiction String?
  payBasis         PayBasis
  /** Hourly rate, or annual salary, in cents. */
  payRateCents     Int
  defaultHours     Float        @default(80)
  nyManualWorker   Boolean      @default(false)
  // Federal Form W-4 (2020 or later)
  w4FilingStatus   String       @default("single") // single | married_jointly | head_of_household
  w4MultipleJobs   Boolean      @default(false)
  w4DependentsCents Int         @default(0)
  w4OtherIncomeCents Int        @default(0)
  w4DeductionsCents Int         @default(0)
  w4ExtraCents     Int          @default(0)
  w4Exempt         Boolean      @default(false)
  /** State withholding certificate (CT-W4, M-4, OR-W-4, IT-2104) as entered. */
  stateW4          Json?
  i9CompletedAt    DateTime?
  /** Direct deposit (stub until TD Bank). Last 4 only. */
  bankLast4        String?
  /** DIRECT_DEPOSIT or CHECK (printed paper check). */
  paymentMethod    String       @default("DIRECT_DEPOSIT")
  /** Pre-tax 401(k) percent of gross, e.g. 0.05. */
  retirementPretaxRate Float    @default(0)
  /** Section 125 health premium per paycheck, cents. */
  healthPremiumCents Int        @default(0)
  electronicW2Consent Boolean   @default(true)
  /** Self-onboarding: the employee was invited to enter their own details, W-4s and bank account. */
  selfOnboardingInvitedAt DateTime?
  /** ...and finished their part. The employer then completes I-9 Section 2. */
  selfOnboardingDoneAt    DateTime?
  /** I-9 Section 1 as the employee attested it (status, signature), when done in the portal. */
  i9Section1       Json?
  createdAt        DateTime     @default(now())
  payRunLines      PayRunLine[]
  advances         Advance[]
  retirementElections RetirementElection[]
}

model Contractor {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  legalName        String
  businessName     String?
  email            String
  /** ssn | ein. Preview mode only accepts test numbers. */
  tinType          String
  tin              String
  addressLine1     String
  city             String
  state            String
  zip              String
  w9ReceivedAt     DateTime?
  bankLast4        String?
  /** DIRECT_DEPOSIT or CHECK. */
  paymentMethod    String       @default("DIRECT_DEPOSIT")
  status           WorkerStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  payments         ContractorPayment[]
}

model ContractorPayment {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  payRunId     String?
  payRun       PayRun?    @relation(fields: [payRunId], references: [id], onDelete: SetNull)
  amountCents  Int
  memo         String?
  paidOn       DateTime
  checks       Check[]
}

model PayRun {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payScheduleId  String
  paySchedule    PaySchedule  @relation(fields: [payScheduleId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  payday         DateTime
  offCycle       Boolean      @default(false)
  status         PayRunStatus @default(DRAFT)
  /** Full engine review at approval time: lines, totals, cash breakdown. */
  summary        Json?
  grossCents     Int          @default(0)
  employerTaxesCents Int      @default(0)
  netCents       Int          @default(0)
  cashNeededCents Int         @default(0)
  approvedById   String?
  approvedAt     DateTime?
  /** Stub money movement reference (TD Bank not integrated). */
  fundingRef     String?
  createdAt      DateTime     @default(now())
  lines          PayRunLine[]
  contractorPayments ContractorPayment[]
  retirementSubmissions RetirementSubmission[]
}

model PayRunLine {
  id           String   @id @default(cuid())
  payRunId     String
  payRun       PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  hours        Float?
  /** Overtime hours, paid at 1.5x the hourly rate (hourly employees). */
  overtimeHours Float   @default(0)
  regularCents Int
  bonusCents   Int      @default(0)
  grossCents   Int      @default(0)
  employeeTaxesCents Int @default(0)
  employerTaxesCents Int @default(0)
  deductionsCents Int   @default(0)
  netCents     Int      @default(0)
  /** Engine output for this paycheck: tax lines, deductions, taxable wages. Paystub source. */
  detail       Json?
  checks       Check[]

  @@unique([payRunId, employeeId])
}

model Advance {
  id               String        @id @default(cuid())
  employeeId       String
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  principalCents   Int
  installmentCents Int
  repaidCents      Int           @default(0)
  status           AdvanceStatus @default(REQUESTED)
  /** Employee typed their name to sign the repayment authorization. */
  authorizationSignedName String?
  authorizationSignedAt   DateTime?
  requestedAt      DateTime      @default(now())
  decidedAt        DateTime?
}

model Filing {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /** 941, 940, W-2, W-3, 1099-NEC, 1096, CT-941, CT-W3, M-941, OQ, NYS-45 */
  form       String
  /** 2026-Q1 or 2026 */
  period     String
  /** Per-recipient forms (W-2, 1099-NEC) name the person. */
  recipient  String?
  status     String    @default("generated") // generated | filed
  /** Every figure the PDF was drawn from, so the archive can be audited without regenerating. */
  data       Json
  pdf        Bytes
  generatedAt DateTime @default(now())
  filedAt    DateTime?

  @@index([companyId, period])
}

model Invoice {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month       String // 2026-11
  peoplePaid  Int
  tier        Int
  totalCents  Int
  lines       Json
  createdAt   DateTime @default(now())

  @@unique([companyId, month])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

enum CheckStatus {
  ISSUED
  VOID
}

/** A printed paper check, for a paycheck or a contractor payment. Voided checks are kept; a reissue gets a new number. */
model Check {
  id                  String             @id @default(cuid())
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payRunLineId        String?
  payRunLine          PayRunLine?        @relation(fields: [payRunLineId], references: [id], onDelete: Cascade)
  contractorPaymentId String?
  contractorPayment   ContractorPayment? @relation(fields: [contractorPaymentId], references: [id], onDelete: Cascade)
  number              Int
  payee               String
  amountCents         Int
  checkDate           DateTime
  status              CheckStatus        @default(ISSUED)
  voidReason          String?
  voidedAt            DateTime?
  createdAt           DateTime           @default(now())

  @@unique([companyId, number])
}

/** A reminder that was sent, so the daily job sends each one once. key e.g. "approve:<runId>". */
model Reminder {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  sentAt    DateTime @default(now())

  @@unique([companyId, key])
}

/**
 * A retirement plan the company offers through a provider (Principal, Fidelity, OregonSaves...).
 * Contributions are figured on every pay run; after payday White Oak builds the provider's file.
 */
model RetirementPlan {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /** Key from src/lib/retirement/providers.ts (principal, oregonsaves, ...). */
  provider          String
  /** 401K | SAFE_HARBOR_401K | SIMPLE_IRA | STATE_AUTO_IRA */
  planType          String
  name              String
  /** Plan / contract number, or the state program's employer ID. */
  planNumber        String?
  /** SETUP (being entered) | ACTIVE (on pay runs) | PAUSED | ENDED */
  status            String   @default("SETUP")
  /** file_upload | sftp | api */
  connectionMethod  String   @default("file_upload")
  /** When the provider confirmed the connection (first file accepted, or partner credentials working). */
  connectedAt       DateTime?
  allowsRoth        Boolean  @default(false)
  allowsCatchUp     Boolean  @default(true)
  simpleApplicable  Boolean  @default(false)
  /** Employer formula: { tiers: [{ rate, upTo }], nonelective }. */
  employerFormula   Json     @default("{\"tiers\":[],\"nonelective\":0}")
  employerPreset    String   @default("none")
  autoEnrollRate    Float    @default(0)
  eligibilityDays   Int      @default(0)
  eligibilityMinAge Int      @default(18)
  createdAt         DateTime @default(now())
  elections         RetirementElection[]
  submissions       RetirementSubmission[]

  @@index([companyId])
}

/** What one employee chose for a plan (or the provider reported). */
model RetirementElection {
  id              String         @id @default(cuid())
  planId          String
  plan            RetirementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /** ENROLLED | OPTED_OUT | NOT_ENROLLED */
  status          String         @default("NOT_ENROLLED")
  pretaxRate      Float          @default(0)
  rothRate        Float          @default(0)
  pretaxFlatCents Int            @default(0)
  rothFlatCents   Int            @default(0)
  /** employer | employee | provider_import | auto */
  source          String         @default("employer")
  /** The program already has this person (state programs need a roster row first). */
  sentToProvider  Boolean        @default(false)
  updatedAt       DateTime       @updatedAt

  @@unique([planId, employeeId])
}

/** The provider file(s) for one paid pay run, and whether they were sent. */
model RetirementSubmission {
  id            String         @id @default(cuid())
  planId        String
  plan          RetirementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payRunId      String
  payRun        PayRun         @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  /** READY (built, waiting to be uploaded) | SENT | CONFIRMED | FAILED */
  status        String         @default("READY")
  /** [{ fileName, content, rows, employeeCents, employerCents }] */
  files         Json
  employeeCents Int
  employerCents Int
  /** Date the money is due at the provider (deposit as soon as possible; DOL safe harbor 7 business days for small plans). */
  dueOn         DateTime
  sentAt        DateTime?
  sentById      String?
  note          String?
  createdAt     DateTime       @default(now())

  @@unique([planId, payRunId])
}

/* ---------- Time Tracking add-on ---------- */

/** What happens to a punch made away from every work location. */
enum GeofenceMode {
  BLOCK // refused: the employee must be at work to punch
  FLAG // allowed, and flagged for the manager to review
  OFF // location is recorded when the phone shares it, but not checked
}

enum PunchSource {
  PHONE // the employee's own phone or computer, signed in
  KIOSK // a shared tablet at the work site
  MANAGER // added or fixed by a manager
}

/** Time Tracking settings, one row per company (created with defaults on first use). */
model TimeSettings {
  id                String       @id @default(cuid())
  companyId         String       @unique
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  geofenceMode      GeofenceMode @default(BLOCK)
  /** GPS fixes less precise than this many meters are flagged as low accuracy. */
  maxAccuracyMeters Int          @default(100)
  /** Ask for a selfie at each punch, so a coworker can't punch for someone else. */
  requirePhoto      Boolean      @default(false)
  /** IANA time zone for workdays and workweeks, e.g. America/New_York. */
  timeZone          String       @default("America/New_York")
  /** First day of the fixed 7-day workweek used for overtime: 0 = Sunday ... 6 = Saturday. */
  weekStartsOn      Int          @default(0)
  updatedAt         DateTime     @updatedAt
}

/** A place employees work. Punches count as "at work" inside its radius. */
model WorkLocation {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  latitude     Float
  longitude    Float
  radiusMeters Int         @default(150)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  entries      TimeEntry[]

  @@index([companyId])
}

/**
 * One shift: a punch in and (once they leave) a punch out, with breaks. Location is captured only
 * at the moment of each punch. inPunch/outPunch hold what was checked: coordinates, accuracy,
 * distance to the nearest work location, the fix time and the device (see src/lib/time/geofence.ts).
 */
model TimeEntry {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationId  String?
  location    WorkLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  clockInAt   DateTime
  clockOutAt  DateTime?
  source      PunchSource   @default(PHONE)
  inPunch     Json
  outPunch    Json?
  /** Review flags, e.g. OUTSIDE_FENCE, LOW_ACCURACY, NO_LOCATION (src/lib/time/flags.ts). */
  flags       String[]      @default([])
  /** Optional selfies (small JPEGs) when the company asks for a photo at punch. */
  inPhoto     Bytes?
  outPhoto    Bytes?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  breaks      TimeBreak[]

  @@index([companyId, clockInAt])
  @@index([employeeId, clockInAt])
}

/** A break inside a shift. Meal breaks are unpaid; short rest breaks are paid. */
model TimeBreak {
  id         String    @id @default(cuid())
  entryId    String
  entry      TimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /** MEAL (unpaid) or REST (paid). */
  kind       String    @default("MEAL")
  startAt    DateTime
  endAt      DateTime?
  startPunch Json?
  endPunch   Json?
}
