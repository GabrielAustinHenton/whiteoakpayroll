# Postgres connection string (Neon, RDS, or local). Required for the app (sign up, payroll, filings).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whiteoak"
# Setup code for creating White Oak admin logins at /admin/setup (or /admin/claim when signed in).
ADMIN_SETUP_TOKEN="change-me-too"
# Comma-separated emails allowed to be White Oak admins. Removing an email revokes that admin at once.
ADMIN_EMAILS="you@example.com,partner@example.com"
# Preview mode accepts only test SSNs/EINs (SSNs starting 000, EINs starting 00). Leave "true" until the security review is done.
TEST_IDS_ONLY="true"
# Email (portal and teammate invites) through Resend: https://resend.com. Without a key, invite links are shown on screen instead.
RESEND_API_KEY=""
# Sender on a domain verified in Resend.
EMAIL_FROM="White Oak Payroll <hello@whiteoakpayroll.com>"
# Site address used in emailed links.
APP_URL="https://whiteoakpayroll.com"
# White Oak payroll staff (operators) who enter data and run payroll for every client. Comma-separated. Not admins.
STAFF_EMAILS=""
# AES-256 key for SSNs and other identifiers: 32 random bytes, base64. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required before TEST_IDS_ONLY is turned off. Rotate by moving the old one to FIELD_ENCRYPTION_OLD_KEYS="k1:<old base64>".
FIELD_ENCRYPTION_KEY=""
FIELD_ENCRYPTION_KEY_ID="k1"
