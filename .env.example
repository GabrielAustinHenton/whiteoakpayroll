# Postgres connection string (Neon, RDS, or local). Required for the app (sign up, payroll, filings).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whiteoak"
# One-time code that turns a signed-in account into a White Oak platform admin at /admin/claim.
ADMIN_SETUP_TOKEN="change-me-too"
# Preview mode accepts only test SSNs/EINs (SSNs starting 000, EINs starting 00). Leave "true" until the security review is done.
TEST_IDS_ONLY="true"
# Email (portal and teammate invites) through Resend: https://resend.com. Without a key, invite links are shown on screen instead.
RESEND_API_KEY=""
# Sender on a domain verified in Resend.
EMAIL_FROM="White Oak Payroll <hello@whiteoakpayroll.com>"
# Site address used in emailed links.
APP_URL="https://whiteoakpayroll.com"
